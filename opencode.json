{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    "knowledge_base/SHARED_CONTEXT.md",
    "skills/MANIFEST.md"
  ],
  "mcp": {
    "reins": {
      "type": "local",
      "command": [".venv/bin/mcp-compressor", "-c", "medium", "--", ".venv/bin/python", "-m", "reins.harness.mcp_server"],
      "enabled": true
    }
  },
  "plugin": ["./.opencode/plugin/reins-awareness.js"],
  "lsp": {
    "basedpyright": {
      "command": [".venv/bin/basedpyright-langserver", "--stdio"],
      "extensions": [".py"]
    }
  }
}
