{
  "folders": [
    { "path": ".", "name": "data_rein (universal harness)" }
  ],
  "settings": {
    "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
    "python.testing.pytestEnabled": true,
    "python.testing.pytestArgs": ["tests"],
    "files.associations": {
      "PRIME_DIRECTIVE.md": "markdown",
      "*.code-workspace": "jsonc"
    },
    "files.exclude": {
      "**/__pycache__": true,
      "**/*.pyc": true,
      "knowledge_base/wiki.db": true
    },
    "terminal.integrated.env.linux": {
      "DATA_REIN_HOME": "${workspaceFolder}"
    }
  },
  "extensions": {
    "recommendations": ["ms-python.python"]
  },
  "launch": {
    "version": "0.2.0",
    "configurations": [
      {
        "name": "reins wiki stats",
        "type": "debugpy",
        "request": "launch",
        "module": "reins.cli",
        "args": ["wiki", "stats"],
        "console": "integratedTerminal"
      }
    ]
  }
}
