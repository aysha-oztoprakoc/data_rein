{
  "_comment": "QLoRA fine-tuning defaults sized for the amdy 8GB VRAM budget. max_seq_len matches the ctx law in coordinator.json; base_model is swappable per run via CLI override.",
  "base_model": "Qwen/Qwen2.5-3B-Instruct",
  "small_base_model": "Qwen/Qwen2.5-3B-Instruct",
  "tiny_base_model": "Qwen/Qwen2.5-0.5B-Instruct",
  "dataset_path": "",
  "output_dir": null,
  "max_seq_len": 2048,
  "per_device_batch_size": 1,
  "gradient_accumulation_steps": 16,
  "num_train_epochs": 3,
  "learning_rate": 0.0002,
  "lora": {
    "r": 16,
    "alpha": 32,
    "dropout": 0.05,
    "target_modules": ["q_proj", "k_proj", "v_proj", "o_proj"]
  },
  "optim": "paged_adamw_8bit",
  "gradient_checkpointing": true
}
