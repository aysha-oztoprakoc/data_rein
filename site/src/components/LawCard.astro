---
interface Props {
  badge: string;
  badgeType?: 'cyan' | 'danger' | 'warning' | 'success';
  title: string;
  description: string;
  benefits: string[];
  tradeoff: string;
  invariant: string;
}

const {
  badge,
  badgeType = 'cyan',
  title,
  description,
  benefits,
  tradeoff,
  invariant
} = Astro.props;
---

<div class="panel law-card">
  <div class="card-head">
    <span class={`chip chip-${badgeType}`}>{badge}</span>
  </div>

  <h3>{title}</h3>
  <p class="law-desc">{description}</p>

  <div class="benefits-block">
    <div class="benefits-label">// ARCHITECTURAL BENEFITS</div>
    <ul>
      {benefits.map(b => <li>{b}</li>)}
    </ul>
  </div>

  <div class="tradeoff-block">
    <span style="color: var(--color-warning); font-weight: 700;">TRADEOFF:</span> {tradeoff}
  </div>

  <div class="card-footer">
    <span class="inv-label">INVARIANT:</span> <span class="inv-value">{invariant}</span>
  </div>
</div>

<style>
  .law-card {
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .card-head {
    margin-bottom: 1rem;
  }

  .law-card h3 {
    margin-bottom: 0.75rem;
    font-size: 1.15rem;
    color: #ffffff;
  }

  .law-desc {
    font-size: 0.88rem;
    line-height: 1.6;
    margin-bottom: 1.25rem;
  }

  .benefits-block {
    margin-bottom: 1.25rem;
    flex-grow: 1;
  }

  .benefits-label {
    font-size: 0.72rem;
    font-weight: 700;
    color: var(--color-text-highlight);
    letter-spacing: 0.08em;
    margin-bottom: 0.5rem;
    font-family: var(--font-mono);
  }

  .benefits-block ul {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .benefits-block li {
    font-size: 0.82rem;
    color: var(--color-text-body);
    display: flex;
    align-items: flex-start;
    gap: 0.45rem;
    font-family: var(--font-mono);
  }

  .benefits-block li::before {
    content: "✓";
    color: var(--color-success);
    font-weight: 700;
  }

  .tradeoff-block {
    font-size: 0.78rem;
    font-family: var(--font-mono);
    color: var(--color-text-dim);
    background: rgba(0, 0, 0, 0.35);
    border: 1px solid var(--color-border-primary);
    padding: 0.6rem 0.75rem;
    margin-bottom: 1rem;
    clip-path: polygon(6px 0, 100% 0, 100% calc(100% - 6px), calc(100% - 6px) 100%, 0 100%, 0 6px);
  }

  .card-footer {
    border-top: 1px solid var(--color-border-primary);
    padding-top: 0.75rem;
    font-size: 0.75rem;
    font-family: var(--font-mono);
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .inv-label {
    color: var(--color-text-dim);
  }

  .inv-value {
    color: var(--color-text-highlight);
    font-weight: 700;
  }
</style>
