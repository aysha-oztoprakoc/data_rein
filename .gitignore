knowledge_base/wiki.db-shm
knowledge_base/wiki.db-wal

# --- Massive binaries / model blobs / nested repos (never commit) ---
# Anchored to repo root so nested dirs of the same name (e.g.
# knowledge_base/agents/odysseus/) are NOT ignored.
/ai_models/
/bin/
/odysseus/
/.gemini/
/logs/
/chroma_notebooklm/

# --- Heavyweight / regenerable / machine-local dirs ---
# Nix binary-cache store + local signing keypair live under config/keys (above).
# wiki_vault/ is a derived Obsidian export (regenerate via scripts/export_to_obsidian.py).
# native/reins-pon-engine is a git submodule (published separately).
# DATA/ is stray local Claude Code project state that leaked into the repo root.
/nix-cache/
/wiki_vault/
/scratch/
/result
/DATA/
/opencode.db
node_modules/
.opencode/node_modules/
.opencode/skills/
/native/*/target/

