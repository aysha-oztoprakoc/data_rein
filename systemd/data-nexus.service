[Unit]
Description=Data Nexus (Observer Daemon)
After=network.target mosquitto.service
Requires=mosquitto.service

[Service]
Type=simple
User=amdy
WorkingDirectory=/home/amdy/data_rein
# Resource limits (3 CPU cores max, 4GB RAM max)
CPUQuota=300%
MemoryMax=4G
Environment="PYTHONPATH=/home/amdy/data_rein/src"
ExecStart=/home/amdy/data_rein/.venv/bin/python -m reins.services.data_nexus.nexus_daemon
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
