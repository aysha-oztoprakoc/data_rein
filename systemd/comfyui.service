[Unit]
Description=ComfyUI Image Generation Server
After=network.target

[Service]
Type=simple
User=amdy
WorkingDirectory=/home/amdy/ComfyUI
ExecStart=/home/amdy/ComfyUI/venv/bin/python main.py --listen 0.0.0.0 --port 8188 --highvram
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
