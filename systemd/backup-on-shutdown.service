[Unit]
Description=Trigger PON Backup on Shutdown (bak-1.1)
DefaultDependencies=no
Before=shutdown.target reboot.target halt.target
Requires=network-online.target
After=network-online.target

[Service]
Type=oneshot
Environment="PATH=/usr/bin:/bin:/usr/sbin:/sbin"
# Trigger the backup via MQTT
ExecStart=/usr/bin/mosquitto_pub -h localhost -t "data_rein/backup/trigger" -m '{"source": "shutdown_hook", "reason": "system_halting"}'
# Allow up to 30 seconds for the backup daemon to complete the rsyncs and git pushes
ExecStartPost=/bin/sleep 30
TimeoutStartSec=60

[Install]
WantedBy=shutdown.target reboot.target halt.target
