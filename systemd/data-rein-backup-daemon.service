[Unit]
Description=Data Rein Resident Backup Daemon (24/7 Listener)
After=network.target mosquitto.service

[Service]
Type=simple
WorkingDirectory=/home/amdy/data_rein
# Execute Python within the uv virtual environment to guarantee dependencies (like paho-mqtt) are met
# Wrapping with taskset to force CPU Pinning to cores 6 and 7 (simulating 2 threads as requested on this 8-core node)
ExecStart=/usr/bin/taskset -c 6,7 /home/amdy/data_rein/.venv/bin/python3 src/data_harness/services/backup_service.py

# Auto-Restart to guarantee 24/7 Uptime
Restart=always
RestartSec=10

# Lower CPU Priority (Nice)
Nice=10

# Lower I/O Priority (3 = Idle, only use disk IO when no one else is using it)
IOSchedulingClass=idle

[Install]
WantedBy=default.target
